# Copy to .env.deploy (git-ignored) and fill in your own values.

# Storage zone credentials, from the storage provider dashboard.
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_PASSWORD=your-storage-zone-password

# Storage hostname for your zone's region.
#BUNNY_STORAGE_HOST=storage.bunnycdn.com

# Account API key. Needed to purge the CDN after upload so updates land at once.
BUNNY_API_KEY=your-account-api-key

# Where the build is published. deploy.mjs uploads there and vite.config.ts
# builds the update/download URLs from it. Without both, the userscript is
# built without auto-update metadata.
SITE_URL=https://example.com
BASE_PATH=some/path
